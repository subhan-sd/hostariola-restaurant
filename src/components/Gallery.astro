---
import type { Dict } from '../i18n';
import { img, galleryImages } from '../i18n';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const aspects = ['4/5', '1/1', '4/3', '3/4', '4/5', '1/1'];
interface G {
  id: string;
  caption: string;
  ratio: string;
}
const items: G[] = galleryImages.map((id, i) => ({
  id,
  caption: t.gallery.captions[i],
  ratio: aspects[i % aspects.length],
}));
---

<section class="section gallery" id="gallery">
  <div class="wrap">
    <div class="gallery-head">
      <div>
        <p class="label reveal">{t.gallery.label}</p>
        <h2 class="h-serif reveal gallery-title">{t.gallery.title}</h2>
      </div>
      <p class="reveal gallery-sub">{t.gallery.sub}</p>
    </div>

    <div class="gallery-grid" style="--cols: 3">
      {
        items.map((item, i) => (
          <figure
            class="reveal gallery-item"
            data-lightbox
            style={`--ratio:${item.ratio}; --n:${i}`}
          >
            <button type="button" class="gallery-btn" aria-label={`${t.gallery.label} — ${item.caption}`}>
              <img
src={img(item.id)}
              data-full={img(item.id)}
                alt={item.caption}
                loading="lazy"
              />
            </button>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <dialog class="lightbox" aria-label={t.gallery.title}>
    <div class="lightbox-stage">
      <button class="lightbox__close" type="button" aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
      {
        items.map((item, i) => (
          <div class="lightbox__img" hidden={i !== 0}>
            <img src={img(item.id)} alt={item.caption} loading="lazy" />
          </div>
        ))
      }
    </div>
    <div class="lightbox-bar">
      <span class="lightbox__count">1 / {items.length}</span>
      <span class="lightbox__title"></span>
    </div>
  </dialog>
</section>

<style>
  .gallery {
    background: var(--ivory);
  }

  .gallery-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .gallery-title {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    margin: 1.2rem 0 0;
  }

  .gallery-sub {
    max-width: 30rem;
    margin: 0 0 0.4rem;
    color: var(--ink-soft);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: clamp(0.9rem, 2vw, 1.6rem);
  }

  .gallery-item {
    margin: 0;
    position: relative;
  }

  .gallery-item:nth-child(2) {
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .gallery-item:nth-child(5) {
    margin-top: clamp(1.4rem, 3vw, 2.6rem);
  }

  .gallery-btn {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .gallery-btn::after {
    content: '＋';
    position: absolute;
    inset: auto;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(247, 242, 232, 0.92);
    color: var(--ink);
    font-size: 1rem;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    pointer-events: none;
  }

  .gallery-btn:hover::after,
  .gallery-btn:focus-visible::after {
    opacity: 1;
    transform: scale(1);
  }

  .gallery-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }

  .gallery-btn:hover img {
    transform: scale(1.05);
  }

  .gallery-item figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  /* lightbox */
  .lightbox {
    border: 0;
    padding: 0;
    background: rgba(20, 18, 14, 0.97);
    color: var(--ivory);
    max-width: min(96vw, 1100px);
    width: 96vw;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(20, 18, 14, 0.9);
    backdrop-filter: blur(4px);
  }

  .lightbox-stage {
    position: relative;
    background: rgba(20, 18, 14, 0.97);
  }

  .lightbox__img {
    aspect-ratio: 16 / 11;
    display: grid;
    place-items: center;
    background: rgba(20, 18, 14, 0.97);
  }

  .lightbox__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid rgba(247, 242, 232, 0.4);
    background: rgba(20, 18, 14, 0.55);
    color: var(--ivory);
    font-size: 1.3rem;
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
  }

  .lightbox__close:hover {
    background: var(--wine);
    transform: rotate(90deg);
  }

  .lightbox-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: rgba(247, 242, 232, 0.85);
    border-top: 1px solid rgba(247, 242, 232, 0.15);
  }

  .lightbox__title {
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      --cols: 2;
    }
    .gallery-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .gallery-item:nth-child(2),
    .gallery-item:nth-child(5) {
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      --cols: 1;
    }
    .gallery-item:nth-child(2),
    .gallery-item:nth-child(5) {
      margin-top: 0;
    }
  }
</style>