---
import type { Dict } from '../i18n';
import { img, images } from '../i18n';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const main = img(images.storyMain);
const second = img(images.storySecondary);
---

<section class="section story" id="story">
  <div class="wrap story-grid">
    <div class="story-media reveal">
      <div class="reveal-img story-main">
        <img src={main} alt="The dining room of Hostariola, set and ready" />
      </div>
      <figure class="reveal-img story-secondary">
        <img src={second} alt="Touches of the room at Hostariola" />
      </figure>
      <span class="story-frame-sq" aria-hidden="true"></span>
    </div>

    <div class="story-copy">
      <p class="label reveal">{t.story.label}</p>
      <h2 class="h-serif reveal story-title">{t.story.title}</h2>
      <p class="reveal">{t.story.p1}</p>
      <p class="reveal">{t.story.p2}</p>
    </div>
  </div>
</section>

<style>
  .story {
    background: var(--ivory);
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .story-media {
    position: relative;
    padding-top: 2rem;
  }

  .story-main img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .story-secondary {
    position: absolute;
    right: -1.5rem;
    bottom: -2.2rem;
    width: 56%;
    margin: 0;
  }

  .story-secondary img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 6px solid var(--ivory);
  }

  .story-frame-sq {
    position: absolute;
    top: 0;
    left: -1.4rem;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--umber);
    opacity: 0.55;
    z-index: -1;
  }

  .story-copy {
    max-width: 34rem;
  }

  .story-title {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    margin: 1.2rem 0 1.6rem;
  }

  .story-quote {
    margin: 2.2rem 0 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--wine);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: var(--ink);
  }

  .story-quote-mark {
    color: var(--wine);
    font-style: italic;
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .story-secondary {
      right: 0rem;
      bottom: -1.5rem;
    }
  }
</style>