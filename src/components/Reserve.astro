---
import type { Dict } from '../i18n';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const phone = t.location.phone.replace(/[^\d+]/g, '');
const wa = t.location.whatsapp.replace(/[^\d]/g, '');
const waUrl = `https://wa.me/${wa}`;
const times = ['12:30', '13:00', '13:30', '19:30', '20:00', '20:30', '21:00'];
---

<section class="section reserve" id="reserve">
  <div class="wrap reserve-grid">
    <div class="reserve-copy">
      <p class="label reveal">{t.reserve.label}</p>
      <h2 class="h-serif reveal reserve-title">{t.reserve.title}</h2>
      <p class="reveal reserve-sub">{t.reserve.sub}</p>
      <div class="reserve-ctas reveal">
        <a class="btn btn--ghost-light" href={`tel:${phone}`}>{t.reserve.ctaCall}</a>
        <a class="btn btn--ghost-light wa-btn" href={waUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35ZM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 1 1 8.38 4.63Zm8.4-18.38A11.82 11.82 0 0 0 12.04 0C5.46 0 .1 5.33.1 11.89c0 2.1.55 4.14 1.59 5.95L0 24l6.32-1.65a11.9 11.9 0 0 0 5.72 1.46h.01c6.57 0 11.93-5.34 11.93-11.9 0-3.18-1.24-6.17-3.5-8.42Z"/></svg>
          {t.location.whatsappCta}
        </a>
      </div>
    </div>

    <form class="reserve-form reveal" aria-label={t.reserve.title}>
      <div class="field">
        <label for="rv-name">{t.reserve.form.name}</label>
        <input id="rv-name" name="name" type="text" autocomplete="name" required placeholder={t.reserve.form.namePh} />
      </div>
      <div class="field">
        <label for="rv-email">{t.reserve.form.email}</label>
        <input id="rv-email" name="email" type="email" autocomplete="email" required placeholder={t.reserve.form.emailPh} />
      </div>
      <div class="field">
        <label for="rv-date">{t.reserve.form.date}</label>
        <input id="rv-date" name="date" type="date" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="rv-time">{t.reserve.form.time}</label>
          <select id="rv-time" name="time" required>
            {
              times.map((time) => <option value={time}>{time}</option>)
            }
          </select>
        </div>
        <div class="field">
          <label for="rv-guests">{t.reserve.form.guests}</label>
          <select id="rv-guests" name="guests" required>
            <option value="1">{t.reserve.form.guestOne}</option>
            {
              Array.from({ length: 7 }, (_, n) => (
                <option value={n + 2}>{t.reserve.form.guestMany(n + 2)}</option>
              ))
            }
          </select>
        </div>
      </div>
      <button class="btn btn--wine reserve-submit" type="submit">{t.reserve.form.submit}</button>
      <p class="field-note">{t.reserve.form.demo}</p>
    </form>

    <p class="reserve-success" role="status" hidden>{t.reserve.form.success}</p>
  </div>
</section>

<style>
  .reserve {
    background: radial-gradient(90% 120% at 15% 0%, #0b1f3a 0%, var(--ink) 55%)
      var(--ink);
    color: var(--ivory);
    position: relative;
    overflow: hidden;
  }

.reserve::before {
  content: '';
  position: absolute;
  width: 40rem;
  height: 40rem;
  right: -16rem;
  top: -16rem;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(19, 103, 168, 0.35), transparent 65%);
  pointer-events: none;
}

  .reserve-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  .reserve-copy {
    position: sticky;
    top: 6rem;
  }

  .reserve-title {
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    margin: 1.2rem 0 1.2rem;
  }

  .reserve-sub {
    max-width: 38ch;
    color: rgba(247, 242, 232, 0.82);
    margin-bottom: 2rem;
  }

  .reserve-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .wa-btn svg {
    transition: transform 0.3s var(--ease);
  }

.wa-btn:hover svg {
    transform: scale(1.15);
  }

  .reserve-form {
    background: rgba(247, 242, 232, 0.06);
    border: 1px solid rgba(247, 242, 232, 0.18);
    padding: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    grid-column: 1 / -1;
  }

  .field label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(247, 242, 232, 0.72);
  }

  .field input,
  .field select {
    width: 100%;
    background: rgba(20, 18, 14, 0.45);
    border: 1px solid rgba(247, 242, 232, 0.28);
    border-radius: 0;
    color: var(--ivory);
    padding: 0.85rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.98rem;
    transition: border-color 0.3s;
  }

  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--umber);
  }

  .field input::placeholder {
    color: rgba(247, 242, 232, 0.45);
  }

  .field select option {
    color: var(--ink);
  }

  .reserve-submit {
    grid-column: 1 / -1;
    margin-top: 0.4rem;
  }

  .field-note {
    grid-column: 1 / -1;
    margin: 0;
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: rgba(247, 242, 232, 0.5);
  }

  .reserve-success {
    grid-column: 1 / -1;
    background: rgba(247, 242, 232, 0.07);
    border: 1px solid rgba(247, 242, 232, 0.25);
    padding: 2rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
  }

  @media (max-width: 860px) {
    .reserve-grid {
      grid-template-columns: 1fr;
    }
    .reserve-copy {
      position: static;
    }
    .reserve-form {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .reserve-form {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
    .reserve-ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .reserve-ctas .btn {
      width: 100%;
    }
  }
</style>