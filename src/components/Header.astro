---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const home = t.lang === 'en' ? '/en/' : '/it/';
const alt = t.lang === 'en' ? '/it/' : '/en/';
const links = [
  ['#story', t.nav.story],
  ['#menu', t.nav.menu],
  ['#gallery', t.nav.gallery],
  ['#contact', t.nav.contact],
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={home} aria-label={`${t.brand} — ${t.brandLine}`}>
      <span class="wordmark-name">{t.brand}</span>
      <span class="wordmark-line">{t.brandLine}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map(([href, label]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
        <li>
          <a class="lang-toggle" href={alt} hreflang={t.lang === 'en' ? 'it' : 'en'}>
            {t.lang === 'en' ? 'IT' : 'EN'}
          </a>
        </li>
      </ul>
    </nav>

<div class="header-actions">
      <a class="lang-toggle site-nav-only" href={alt} hreflang={t.lang === 'en' ? 'it' : 'en'}>
        {t.lang === 'en' ? 'IT' : 'EN'}
      </a>
      <a class="btn btn--wine header-book" href="#reserve">{t.nav.book}</a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="nav-scrim" aria-hidden="true"></div>
<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <button class="nav-close" type="button" aria-label="Close menu">×</button>
  <nav aria-label="Mobile">
    <a href={home}>{t.nav.home}</a>
    <a href="#story">{t.nav.story}</a>
    <a href="#menu">{t.nav.menu}</a>
    <a href="#gallery">{t.nav.gallery}</a>
    <a href="#contact">{t.nav.contact}</a>
    <a class="mobile-book btn btn--wine" href="#reserve">{t.nav.book}</a>
    <a class="lang-toggle" href={alt} hreflang={t.lang === 'en' ? 'it' : 'en'}>
      {t.lang === 'en' ? 'Versione italiana' : 'English version'}
    </a>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    padding-block: 1.4rem;
    transition: padding 0.4s var(--ease), background 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .site-header.scrolled {
    background: rgba(247, 242, 232, 0.92);
    backdrop-filter: blur(10px);
    padding-block: 0.8rem;
    box-shadow: 0 1px 0 var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ivory);
    transition: color 0.4s var(--ease);
  }

  .site-header.scrolled .wordmark {
    color: var(--ink);
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.42em;
    font-weight: 500;
    line-height: 1;
  }

  .wordmark-line {
    margin-top: 0.35rem;
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .site-nav ul {
    display: flex;
    gap: 2.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a,
  .site-nav-only {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ivory);
    opacity: 0.9;
    transition: opacity 0.3s;
  }

  .site-header.scrolled .site-nav a,
  .site-header.scrolled .site-nav-only {
    color: var(--ink);
  }

  .site-nav a:hover,
  .site-nav-only:hover {
    opacity: 1;
  }

  .site-nav-only {
    margin-right: 1.2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  .site-nav-only {
    display: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 7px;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 26px;
    height: 1.5px;
    background: var(--ivory);
    transition: background 0.4s var(--ease);
  }

  .site-header.scrolled .nav-toggle span {
    background: var(--ink);
  }

  .nav-scrim {
    display: none;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }
    .site-nav-only {
      display: none;
    }
    .header-book {
      padding: 0.65rem 1rem;
      font-size: 0.68rem;
    }
    .wordmark-name {
      font-size: 1.1rem;
    }
    .wordmark-line {
      font-size: 0.55rem;
    }
    .nav-toggle,
    .nav-toggle span {
      display: flex;
    }
    .nav-toggle {
      margin-left: 0.5rem;
    }
    .nav-scrim {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(20, 18, 14, 0.55);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease);
      z-index: 54;
    }
    .nav-scrim.open {
      opacity: 1;
      pointer-events: auto;
    }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(86vw, 21rem);
      background: var(--olive);
      color: var(--ivory);
      padding: 4.6rem var(--gutter) 2rem;
      transform: translateX(100%);
      transition: transform 0.5s var(--ease);
      z-index: 55;
      overflow-y: auto;
      visibility: hidden;
      pointer-events: none;
      box-shadow: -24px 0 60px -30px rgba(20, 18, 14, 0.6);
    }
    .mobile-nav.open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }
    .nav-close {
      position: absolute;
      top: 1.15rem;
      right: var(--gutter);
      width: 2.5rem;
      height: 2.5rem;
      display: grid;
      place-items: center;
      background: none;
      border: 1px solid rgba(247, 242, 232, 0.35);
      border-radius: 50%;
      color: var(--ivory);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      transition: border-color 0.3s, background 0.3s;
    }
    .nav-close:hover {
      background: var(--wine);
      border-color: var(--wine);
    }
    .mobile-nav nav {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .mobile-nav nav > a:not(.btn) {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 420;
      color: var(--ivory);
      text-decoration: none;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--line-light);
    }
    .mobile-nav nav > a:not(.btn):hover {
      color: var(--cream);
    }
    .mobile-book {
      margin-top: 1.15rem;
      padding: 0.7rem 1rem;
      font-size: 0.72rem;
      align-self: center;
      width: 100%;
    }
    .lang-toggle {
      margin-top: 1.4rem;
      align-self: center;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.7;
      border-bottom: 0;
      padding: 0.3rem 0;
    }
  }

  @media (max-width: 860px) and (max-height: 680px) {
    .mobile-nav {
      padding-top: 4rem;
      padding-bottom: 1.4rem;
    }
    .mobile-nav nav > a:not(.btn) {
      font-size: 1.25rem;
      padding: 0.32rem 0;
    }
    .mobile-book {
      margin-top: 0.9rem;
    }
    .lang-toggle {
      margin-top: 1rem;
    }
  }

  @media (min-width: 861px) {
    .lang-toggle.site-nav-only {
      display: none;
    }
  }
</style>